{
  "name": "Incident Response v1 (deterministic, no LLM)",
  "nodes": [
    {
      "id": "97833be7-0e31-58ad-9ec8-ceb701b094e4",
      "name": "Incident webhook",
      "webhookId": "0ed68163-37be-5a06-86b1-7815a171c8da",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -320,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "incident",
        "responseMode": "onReceived",
        "options": {}
      }
