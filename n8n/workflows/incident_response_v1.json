    },
    {
      "id": "20748177-0a29-5dd7-ad9b-fa42827c25fd",
      "name": "POST status ESCALATED",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueRegularOutput",
      "position": [
        1660,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Incident webhook').first().json.body.backend_base_url }}/api/ai/n8n/status/{{ $('Incident webhook').first().json.body.incident_id }}",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'ESCALATED', note: 'Action was authorised but verification did not confirm the plant changed: ' + ($json.details || []).filter(d => !d.passed).map(d => d.check).join('; '), produced_by: 'n8n incident_response_v1' }) }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
