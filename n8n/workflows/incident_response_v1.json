    },
    {
      "id": "269d151c-852f-5535-9644-b62e6b38c34f",
      "name": "Outcome without approval",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        460
      ],
      "parameters": {
        "jsCode": "// The Wait node resumes either because the owner decided, or because its 10 minute limit expired.\n// Distinguish the two: a cancel is a human decision, a timeout is an unattended incident.\nconst decision = ($json.body && $json.body.decision) || $json.decision || 'timeout';\nconst cancelled = decision === 'cancel';\nreturn [{\n  json: {\n    decision,\n    status: cancelled ? 'DISMISSED' : 'ESCALATED',\n    note: cancelled\n      ? 'Owner cancelled the recommended action in the dashboard; incident dismissed by human decision.'\n      : 'No owner decision in 10 min -> escalated. Nobody acted on the recommendation inside the '\n        + 'approval window, so this incident needs a human now.',\n  },\n}];"
      }
    },
    {
      "id": "903140a9-92fb-5e93-bf51-e585be505619",
      "name": "POST status (cancel or timeout)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueRegularOutput",
      "position": [
        1220,
        460
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Incident webhook').first().json.body.backend_base_url }}/api/ai/n8n/status/{{ $('Incident webhook').first().json.body.incident_id }}",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: $json.status, note: $json.note, produced_by: 'n8n incident_response_v1' }) }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
