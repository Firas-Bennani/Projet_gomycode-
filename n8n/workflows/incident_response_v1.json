        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'RESOLVING', note: 'Owner authorised the action and verification passed: ' + ($json.details || []).filter(d => d.passed).map(d => d.check).join('; '), produced_by: 'n8n incident_response_v1' }) }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
