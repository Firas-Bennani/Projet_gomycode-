    {
      "id": "021d1c9b-12e4-5de2-b6cd-32816ce4640f",
      "name": "Template recommendation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -100,
        300
      ],
      "parameters": {
        "jsCode": "// Deterministic recommendation. No LLM: this is the fallback path that must always work,\n// and in v1 it is the only path. It chooses ONLY from allowed_actions, which the backend\n// built from ai/actions_catalog.py.\nconst input = $input.first().json;\nconst payload = input.body || input;\nconst incident = payload.incident || {};\nconst allowed = payload.allowed_actions || [];\nconst evidence = payload.evidence || [];\nconst workers = payload.workers || [];\n\nconst allowedIds = allowed.map(a => a.id);\nconst byHazard = {\n  MACHINE_OVERHEATING: ['stop_machine', 'evacuate_zone', 'activate_cooling'],\n  INDUSTRIAL_FIRE: ['trigger_alarm', 'evacuate_zone', 'close_door', 'activate_suppression'],\n  CYBER_INTRUSION: ['vlan_quarantine', 'isolate_device'],\n};\nconst chosen = (byHazard[incident.type] || allowedIds).filter(id => allowedIds.includes(id));\n\nconst hazard = String(incident.type || 'hazard').replace(/_/g, ' ').toLowerCase();\nconst assets = (incident.affected_assets || []).join(', ') || 'the affected zone';\nconst names = workers.map(w => `${w.id} (${w.role})`).join(', ');\n\nreturn [{\n  json: {\n    incident_id: payload.incident_id,\n    backend_base_url: payload.backend_base_url,\n    allowed_action_ids: allowedIds,\n    what: `${hazard} affecting ${assets} in ${incident.zone}`,\n    why: evidence.map(e => `${e.source}: ${e.detail}`),\n    impact: workers.length\n      ? `${workers.length} person(s) exposed in ${incident.zone}: ${names}. Unplanned loss of ${assets}.`\n      : `No personnel currently detected in ${incident.zone}. Unplanned loss of ${assets}.`,\n    prediction: `Without intervention the condition on ${assets} is expected to continue worsening; `\n      + `severity at detection was ${incident.severity} with ${Math.round((incident.confidence || 0) * 100)}% fused confidence.`,\n    recommended_action_ids: chosen,\n    sources: [],\n    produced_by: 'n8n template (deterministic, no LLM)',\n    fallback: true,\n  },\n}];"
      }
    },
    {
      "id": "f5a946b8-5d5e-564d-b64f-f755aa0d8976",
      "name": "Validate against allowed_actions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        120,
        300
      ],
      "parameters": {
        "jsCode": "// Belt and braces: the backend validates ids against the catalogue as well, but an id that\n// never leaves n8n is one fewer rejection to explain. Also de-duplicates.\nconst item = $input.first().json;\nconst allowed = new Set(item.allowed_action_ids || []);\nconst proposed = item.recommended_action_ids || [];\nconst validated = [...new Set(proposed)].filter(id => allowed.has(id));\nconst rejected = [...new Set(proposed)].filter(id => !allowed.has(id));\nreturn [{ json: { ...item, recommended_action_ids: validated, rejected_action_ids: rejected } }];"
      }
    },
    {
      "id": "c44d073e-7f67-5bb9-b32d-114023ce1fe5",
      "name": "POST enrichment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        340,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.backend_base_url }}/api/ai/n8n/enrichment/{{ $json.incident_id }}",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ what: $json.what, why: $json.why, impact: $json.impact, prediction: $json.prediction, recommended_action_ids: $json.recommended_action_ids, sources: $json.sources, produced_by: $json.produced_by, fallback: $json.fallback, resume_url: $execution.resumeUrl }) }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Copilot-Service-Token",
              "value": "copilot-n8n-shared-secret-2026"
            }
          ]
        }
      }
    },
    {
      "id": "3c8c2669-72c6-5f78-a896-bbdf07724827",
      "name": "Wait for owner decision (10 min)",
      "webhookId": "735d0ca3-4ae9-5c15-bd86-57fed41a23e7",
