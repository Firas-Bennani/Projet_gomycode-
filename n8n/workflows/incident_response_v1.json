      ],
      "parameters": {
        "resume": "webhook",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "limitWaitTime": true,
        "resumeAmount": 10,
        "resumeUnit": "minutes",
        "options": {}
      }
    },
    {
      "id": "de3871ff-6647-5dc4-b1d2-12b29c417e8d",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        780,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "9ec3bd3b-4a16-5dfe-b7cf-ddf80f70c86e",
              "leftValue": "={{ ($json.body && $json.body.decision) || $json.decision || 'timeout' }}",
              "rightValue": "approve",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "e41f67e7-bd2d-5122-9c1e-c7a9107c4e41",
      "name": "Wait 15s for the plant to settle",
      "webhookId": "1099bb12-8c39-5b8b-a6b9-3c6b8908889c",
