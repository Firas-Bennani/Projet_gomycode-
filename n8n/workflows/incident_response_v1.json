              "leftValue": "={{ $json.verified ? 'yes' : 'no' }}",
              "rightValue": "yes",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "cac0c999-87ca-5d80-b077-36846ededdc0",
      "name": "POST status RESOLVING",
      "type": "n8n-nodes-base.httpRequest",
