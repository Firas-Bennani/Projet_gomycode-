# ============================================================
# AI Industrial Copilot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# ============================================================

# ---- Database ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=industrial_copilot
POSTGRES_USER=copilot
POSTGRES_PASSWORD=changeme

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- MQTT ----
MQTT_BROKER=mosquitto
MQTT_PORT=1883

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ---- AI ----
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DB_PATH=./data/vectordb

# ---- Frontend ----
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ============================================================
# ---- n8n orchestration (Engineer 1) ----
# ============================================================
# Master switch. false = the backend never calls n8n and always uses its own
# deterministic template recommendations. Detection is unaffected either way.
N8N_ENABLED=true

# Where the backend POSTs a new incident.
#   backend on the host (venv):   http://localhost:5678/webhook/incident
#   backend inside docker compose: http://n8n:5678/webhook/incident
N8N_INCIDENT_WEBHOOK_URL=http://localhost:5678/webhook/incident

# n8n builds Wait-node resume URLs from its own WEBHOOK_URL (http://localhost:5678).
# A backend running inside compose cannot resolve "localhost", so the bridge rewrites
# the public base to the internal one. Leave both set; they are harmless on the host.
N8N_PUBLIC_BASE=http://localhost:5678
N8N_INTERNAL_BASE=http://n8n:5678

# Timeout for the fire-and-forget POST to n8n. Never blocks the orchestrator.
N8N_TIMEOUT_SECONDS=3

# How n8n reaches the backend. Sent to n8n in the incident payload, so the workflow JSON
# never hardcodes a host.
#   n8n on the host (npx n8n) + backend on the host  -> http://127.0.0.1:8000  <-- our setup
# Use the IPv4 literal, NOT "localhost": Node 18+ resolves localhost to ::1 first while
# uvicorn binds 127.0.0.1 only, so n8n gets "connection refused" against http://localhost:8000.
#   n8n in Docker + backend on the host              -> http://host.docker.internal:8000
#   both inside docker compose                       -> http://backend:8000
BACKEND_BASE_URL_FOR_N8N=http://localhost:8000

# ---- pgvector (RAG store, only if you run n8n in Docker) ----
# NOT USED in the host-only setup: Step 5 uses n8n's in-memory Simple Vector Store instead,
# with the keyword RAG in backend/ai/rag/rag_engine.py as the fallback.
# Host/port as seen FROM the n8n container: pgvector:5432
# From your machine: localhost:5433
PGVECTOR_DB=n8n_rag
PGVECTOR_USER=n8n
PGVECTOR_PASSWORD=n8n_rag_pw

# ---- Authentication (Industrial_Copilot) ----
# Signing secret for user tokens. CHANGE THIS. 30-minute expiry is set in code.
AUTH_SECRET=change-me-to-a-long-random-string

# Shared secret n8n presents to the backend on /api/ai/n8n/* (machine-to-machine, no user session).
# Must match the X-Copilot-Service-Token header in the n8n workflow HTTP nodes.
N8N_SERVICE_TOKEN=copilot-n8n-shared-secret-change-me

# Shared secret the agents use to sign the messages they send each other (HMAC-SHA256).
# The cyber agent rejects any inter-agent message without a valid tag. Unset, a development
# default is used so the demo runs out of the box - stated openly, because a secret committed to
# a repository is not a secret. See backend/ai/agent_bus_auth.py.
AGENT_BUS_SECRET=change-me-agent-bus-signing-secret

# Optional: live weather source for the storm_forecast scenario. Open-Meteo needs no key; leaving
# this false keeps the deterministic simulated forecast, which is what the demo should use.
WEATHER_LIVE=false

# Demo users (passwords are stored as PBKDF2-SHA256 hashes in backend/app/data/seed/users.json):
#   firas    / Copilot#Owner2026     role owner    - may AUTHORIZE actions and edit records
#   operator / Copilot#Operator2026  role operator - read-only
#   auditor  / Copilot#Auditor2026   role operator - read-only
